    <script>
        (function () {
            'use strict';

            // ── Detect user motion preference (WCAG 2.3.3) ──
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            // ── MOBILE NAV ──
            const hamburger = document.getElementById('hamburger');
            const mobileNav = document.getElementById('mobile-nav');

            hamburger.addEventListener('click', function () {
                const isOpen = mobileNav.classList.contains('open');
                if (isOpen) {
                    mobileNav.classList.remove('open');
                    mobileNav.hidden = true;
                    hamburger.setAttribute('aria-expanded', 'false');
                    hamburger.setAttribute('aria-label', 'Mở menu điều hướng');
                } else {
                    mobileNav.classList.add('open');
                    mobileNav.hidden = false;
                    hamburger.setAttribute('aria-expanded', 'true');
                    hamburger.setAttribute('aria-label', 'Đóng menu điều hướng');
                    // Move focus to first link when opening
                    const firstLink = mobileNav.querySelector('a');
                    if (firstLink) firstLink.focus();
                }
            });

            // Close on link click & on Escape
            mobileNav.querySelectorAll('a').forEach(function (a) {
                a.addEventListener('click', function () {
                    mobileNav.classList.remove('open');
                    mobileNav.hidden = true;
                    hamburger.setAttribute('aria-expanded', 'false');
                    hamburger.setAttribute('aria-label', 'Mở menu điều hướng');
                });
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && mobileNav.classList.contains('open')) {
                    mobileNav.classList.remove('open');
                    mobileNav.hidden = true;
                    hamburger.setAttribute('aria-expanded', 'false');
                    hamburger.focus();
                }
            });

            // ── CLEAN URL SMOOTH SCROLL ──
            const internalPaths = ['/problem', '/solution', '/how-it-works', '/features', '/about', '/contact', '/consultation'];

            document.querySelectorAll('a').forEach(function (a) {
                const href = a.getAttribute('href');
                if (internalPaths.includes(href) || href === '/') {
                    a.addEventListener('click', function (e) {
                        e.preventDefault();
                        const targetId = href === '/' ? 'home' : href.slice(1);
                        const target = document.getElementById(targetId);

                        if (target) {
                            history.pushState(null, '', href);
                            if (!prefersReducedMotion) {
                                target.scrollIntoView({ behavior: 'smooth' });
                            } else {
                                target.scrollIntoView();
                            }
                            const heading = target.querySelector('h1, h2, h3');
                            if (heading) {
                                heading.setAttribute('tabindex', '-1');
                                heading.focus({ preventScroll: true });
                            }
                        }
                    });
                }
            });

            // Handle initial load scroll based on URL
            window.addEventListener('load', function () {
                const path = window.location.pathname;
                if (internalPaths.includes(path)) {
                    const targetId = path.slice(1);
                    const target = document.getElementById(targetId);
                    if (target) {
                        setTimeout(() => {
                            target.scrollIntoView({ behavior: 'smooth' });
                        }, 100);
                    }
                }
            });

            // ── FAQ ACCORDION — WCAG 4.1.2 ──
            const srAnnounce = document.getElementById('sr-announce');

            function announce(text) {
                srAnnounce.textContent = '';
                // Timeout needed for screen reader to pick up change
                setTimeout(function () { srAnnounce.textContent = text; }, 50);
            }

            document.querySelectorAll('.faq-question').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const expanded = btn.getAttribute('aria-expanded') === 'true';
                    const panelId = btn.getAttribute('aria-controls');
                    const panel = document.getElementById(panelId);
                    const questionText = btn.querySelector('span').textContent.trim();

                    // Close all
                    document.querySelectorAll('.faq-question').forEach(function (b) {
                        b.setAttribute('aria-expanded', 'false');
                        const p = document.getElementById(b.getAttribute('aria-controls'));
                        if (p) {
                            if (!prefersReducedMotion) {
                                p.style.maxHeight = null;
                            } else {
                                p.style.maxHeight = '0';
                            }
                        }
                    });

                    if (!expanded) {
                        btn.setAttribute('aria-expanded', 'true');
                        if (panel) {
                            panel.style.maxHeight = panel.scrollHeight + 'px';
                        }
                        announce('Đang hiển thị câu trả lời cho: ' + questionText);
                    } else {
                        announce('Đã đóng câu trả lời.');
                    }
                });

                // WCAG 2.1.1 — Keyboard: Space and Enter both work (native button ✓)
                // WCAG 2.1.1 — Arrow key navigation inside FAQ
                btn.addEventListener('keydown', function (e) {
                    const allBtns = [...document.querySelectorAll('.faq-question')];
                    const idx = allBtns.indexOf(btn);
                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        (allBtns[idx + 1] || allBtns[0]).focus();
                    } else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        (allBtns[idx - 1] || allBtns[allBtns.length - 1]).focus();
                    } else if (e.key === 'Home') {
                        e.preventDefault();
                        allBtns[0].focus();
                    } else if (e.key === 'End') {
                        e.preventDefault();
                        allBtns[allBtns.length - 1].focus();
                    }
                });
            });

            // ── VOICE TTS — WCAG 1.3.3 ──
            const voiceBtn = document.getElementById('voice-toggle');
            const voiceLabel = document.getElementById('voice-label');
            let voiceOn = false;
            const synth = window.speechSynthesis;
            let currentReadingEl = null;

            function speak(text, el) {
                if (!voiceOn || !text || !synth) return;

                // If already reading this element, don't restart
                if (currentReadingEl === el) return;

                synth.cancel();

                // Clear previous highlight
                if (currentReadingEl) {
                    currentReadingEl.classList.remove('reading-highlight');
                }

                currentReadingEl = el;
                if (el) el.classList.add('reading-highlight');

                const utt = new SpeechSynthesisUtterance(text.trim());
                utt.lang = 'vi-VN';
                utt.rate = 1.0;
                utt.pitch = 1.0;

                utt.onend = function () {
                    if (currentReadingEl === el) {
                        el.classList.remove('reading-highlight');
                        currentReadingEl = null;
                    }
                };

                synth.speak(utt);
            }

            function stopSpeaking() {
                if (!voiceOn) return;
                synth.cancel();
                if (currentReadingEl) {
                    currentReadingEl.classList.remove('reading-highlight');
                    currentReadingEl = null;
                }
            }

            voiceBtn.addEventListener('click', function () {
                voiceOn = !voiceOn;
                voiceBtn.setAttribute('aria-pressed', voiceOn);
                // WCAG 4.1.2 — Update aria-label to reflect new state
                voiceBtn.setAttribute('aria-label',
                    voiceOn
                        ? 'Tắt hỗ trợ giọng nói'
                        : 'Bật hỗ trợ giọng nói');
                voiceLabel.textContent = voiceOn ? 'Đang đọc' : 'Đọc nội dung';

                announce(voiceOn
                    ? 'Chế độ hỗ trợ giọng nói đã bật. Rê chuột, dùng phím Tab hoặc chạm vào nội dung để nghe.'
                    : 'Chế độ hỗ trợ giọng nói đã tắt.');

                if (voiceOn) {
                    speak('Chế độ hỗ trợ giọng nói đã bật. Rê chuột, dùng Tab hoặc chạm để nghe nội dung.', voiceBtn);
                } else {
                    stopSpeaking();
                }
            });

            // Expand selectors to cover more content types
            const readSelectors = 'h1, h2, h3, h4, h5, h6, p, li, a, button, [data-read], [aria-label]';
            document.querySelectorAll(readSelectors).forEach(function (el) {
                // Skip hidden or explicitly ignored elements
                if (el.hasAttribute('data-no-read') || el.closest('[aria-hidden="true"]')) return;

                function handleRead(e) {
                    if (!voiceOn) return;
                    if (e) e.stopPropagation(); // Prevent bubble to parent read-elements

                    const text = el.getAttribute('data-read') || el.getAttribute('aria-label') || el.innerText;
                    if (text && text.trim().length > 0) {
                        speak(text, el);
                    }
                }

                // Desktop events
                el.addEventListener('mouseenter', handleRead);
                el.addEventListener('focus', handleRead);
                el.addEventListener('mouseleave', stopSpeaking);
                el.addEventListener('blur', stopSpeaking);

                // Mobile support: Read on touch
                el.addEventListener('touchstart', function (e) {
                    if (voiceOn) {
                        handleRead(e);
                    }
                }, { passive: true });
            });

            // ── SCROLL-REVEAL (disabled if prefers-reduced-motion) ──
            if (!prefersReducedMotion && 'IntersectionObserver' in window) {
                const items = document.querySelectorAll(
                    '.problem-card, .step-card, .feature-card, .benefit-item, .user-card, .team-card, .faq-item, .solution-feature'
                );
                items.forEach(function (el) {
                    el.style.opacity = '0';
                    el.style.transform = 'translateY(18px)';
                    el.style.transition = 'opacity .5s ease, transform .5s ease';
                });
                const revealObserver = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.style.opacity = '1';
                            entry.target.style.transform = 'none';
                            revealObserver.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1 });
                items.forEach(function (el) { revealObserver.observe(el); });
            }

            // ── NAV: mark current section as active ──
            const navLinks = document.querySelectorAll('nav.desktop-nav a');
            const sections = document.querySelectorAll('main section[id]');
            const navObserver = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        const id = entry.target.getAttribute('id');
                        navLinks.forEach(function (link) {
                            const href = link.getAttribute('href');
                            const match = href === '/' + id || (id === 'home' && href === '/');
                            if (match) {
                                link.setAttribute('aria-current', 'page');
                            } else {
                                link.removeAttribute('aria-current');
                            }
                        });
                    }
                });
            }, { threshold: 0.5 });
            sections.forEach(function (s) { navObserver.observe(s); });
            // ── CONSULTATION FORM SUBMISSION ──
            const consultationForm = document.getElementById('consultation-form');
            const successMsg = document.getElementById('success-message');
            window.submitted = false;

            window.showSuccess = function () {
                if (window.submitted) {
                    consultationForm.reset();
                    successMsg.style.display = 'block';
                    announce('Đăng ký thành công! Chúng tôi sẽ liên hệ với bạn sớm nhất.');
                    window.submitted = false;
                    // Auto hide after 8 seconds
                    setTimeout(() => {
                        successMsg.style.display = 'none';
                    }, 8000);
                }
            };

        })();
    </script>
</body>

</html>