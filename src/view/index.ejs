    <!-- Text-to-Speech Accessibility Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const voiceToggle = document.getElementById('voice-toggle');
            const voiceStatus = document.getElementById('voice-status');
            let isVoiceEnabled = false;
            let synth = window.speechSynthesis;

            // Chức năng bật/tắt đọc màn hình
            voiceToggle.addEventListener('click', () => {
                isVoiceEnabled = !isVoiceEnabled;
                voiceToggle.setAttribute('aria-pressed', isVoiceEnabled);

                if (isVoiceEnabled) {
                    voiceToggle.classList.replace('bg-gray-200', 'bg-green-600');
                    voiceToggle.classList.replace('text-gray-800', 'text-white');
                    voiceStatus.textContent = "Đọc nội dung: Bật";
                    speak("Chế độ hỗ trợ đọc giọng nói đã được bật. Nhấn phím Tab để di chuyển qua các thành phần.");
                } else {
                    voiceToggle.classList.replace('bg-green-600', 'bg-gray-200');
                    voiceToggle.classList.replace('text-white', 'text-gray-800');
                    voiceStatus.textContent = "Đọc nội dung: Tắt";
                    synth.cancel();
                }
            });

            function speak(text) {
                if (!isVoiceEnabled || !text) return;
                synth.cancel(); // Dừng phát đang đọc

                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'vi-VN';
                // Cấu hình một chút giọng điệu nếu cần
                utterance.rate = 1.0;
                utterance.pitch = 1.0;

                synth.speak(utterance);
            }

            // Lắng nghe sự kiện hover và focus để đọc nội dung
            const readableElements = document.querySelectorAll('a, button, [data-read], h1, h2, h3, h4, input, textarea');

            readableElements.forEach(el => {
                const handleRead = () => {
                    let textToRead = el.getAttribute('aria-label')
                        || el.getAttribute('data-read')
                        || (el.labels && el.labels[0] ? el.labels[0].innerText : null)
                        || el.innerText
                        || el.value;

                    if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
                        const placeholder = el.getAttribute('placeholder');
                        textToRead = `Trường nhập liệu: ${textToRead}. ${placeholder ? placeholder : ''}`;
                    }

                    speak(textToRead);
                };

                el.addEventListener('focus', handleRead);
                el.addEventListener('mouseenter', handleRead);

                // Dừng đọc khi rời chuột
                el.addEventListener('mouseleave', () => {
                    if (isVoiceEnabled) synth.cancel();
                });
                el.addEventListener('blur', () => {
                    if (isVoiceEnabled) synth.cancel();
                });
            });

            // Xử lý Skip link focus
            document.getElementById('skip-link').addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.getElementById('main-content');
                target.setAttribute('tabindex', '-1');
                target.focus();
                speak("Đã chuyển đến nội dung chính.");
            });

            // Xử lý Menu trên Mobile (Hamburger)
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            if (mobileMenuBtn && mobileMenu) {
                mobileMenuBtn.addEventListener('click', () => {
                    const expanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
                    mobileMenuBtn.setAttribute('aria-expanded', !expanded);
                    mobileMenu.classList.toggle('hidden');
                    mobileMenu.classList.toggle('flex');
                });
                
                // Đóng menu khi bấm vào bất kỳ thẻ a nào trên điện thoại
                mobileMenu.querySelectorAll('a').forEach(link => {
                    link.addEventListener('click', () => {
                        mobileMenu.classList.add('hidden');
                        mobileMenu.classList.remove('flex');
                        mobileMenuBtn.setAttribute('aria-expanded', 'false');
                    });
                });
            }

            // Xử lý "Clean URL" (không có dấu #) - Điều hướng dạng SPA
            document.querySelectorAll('a[href^="/"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    const href = this.getAttribute('href');
                    if(href === "/") return; // Bỏ qua link trang chủ mặc định
                    
                    const targetId = href.substring(1);
                    const targetSection = document.getElementById(targetId);
                    
                    if (targetSection) {
                        e.preventDefault(); // Ngăn trình duyệt nạp lại trang
                        window.history.pushState({}, '', '/' + targetId); // Đổi URL
                        targetSection.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            });

            // Nếu người dùng truy cập trực tiếp từ URL (VD: nhấn F5 tại trang /about)
            const path = window.location.pathname.substring(1);
            if (path) {
                const target = document.getElementById(path);
                if (target) {
                    // Đợi giao diện render xong rồi cuộn xuống
                    setTimeout(() => target.scrollIntoView({ behavior: 'auto' }), 100);
                }
            }
        });
    </script>
