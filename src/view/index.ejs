<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> – Thiết bị hỗ trợ di chuyển cho người khiếm thị
    </title>
    <meta name="description"
        content="SafeEye – Thiết bị đeo tích hợp AI và camera giúp người khiếm thị nhận diện vật cản, di chuyển an toàn và tự tin hơn trong mọi môi trường.">

    <!-- Open Graph / SEO -->
    <meta property="og:title" content="SafeEye – Thiết bị hỗ trợ di chuyển cho người khiếm thị">
    <meta property="og:description"
        content="Thiết bị đeo AI giúp người khiếm thị nhận diện vật cản và di chuyển an toàn.">
    <meta property="og:type" content="website">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">

    <style>
        /* ═══════════════════════════════════════
           WCAG 2.1 AA DESIGN SYSTEM
           Primary: #066EEB (4.5:1+ on white ✓)
           Text dark: #1a1a1a  (16:1 on white ✓)
           Text muted: #374151 (8.6:1 on white ✓)
           White on #066EEB: 5.4:1 ✓
        ═══════════════════════════════════════ */
        :root {
            /* Core Brand */
            --primary: #066EEB;
            --primary-dark: #0452B8;
            --primary-hover: #0561CC;
            --primary-bg: #EBF3FE;
            --primary-bg2: #D6E8FD;

            /* Backgrounds */
            --bg: #FFFFFF;
            --bg2: #F5F8FF;
            --border: #BDCFE8;
            --border2: #DDE8F5;

            /* Text — all verified WCAG AA ≥ 4.5:1 on white */
            --text: #1A1A1A;
            /* 18.1:1 */
            --text-muted: #374151;
            /*  8.6:1 */
            --text-light: #4B5563;
            /*  7.4:1 */

            /* Semantic */
            --success: #065F46;
            /* dark green, 8:1 on white ✓ */
            --success-bg: #D1FAE5;
            --danger: #991B1B;
            /* dark red, 7.5:1 on white ✓ */
            --danger-bg: #FEE2E2;

            /* Focus ring — visible on BOTH blue and white bg */
            --focus-ring: #FFD600;
            /* AA on blue bg ✓ */
            --focus-shadow: rgba(255, 214, 0, .5);

            /* Spacing */
            --section-pad: 5rem;
            --card-radius: 1rem;
            --card-shadow: 0 2px 12px rgba(0, 60, 160, .08), 0 1px 3px rgba(0, 0, 0, .06);
        }

        /* ── RESET ── */
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Respect user motion preferences — WCAG 2.3.3 */
        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
                scroll-behavior: auto !important;
            }
        }

        html {
            scroll-behavior: smooth;
        }

        /* Base font ≥ 18px avoids WCAG 1.4.4 issues */
        body {
            font-family: 'Be Vietnam Pro', system-ui, -apple-system, sans-serif;
            font-size: 1.125rem;
            /* 18px */
            line-height: 1.65;
            color: var(--text);
            background: var(--bg);
            overflow-x: hidden;
        }

        /* ── WCAG 2.4.7 — FOCUS VISIBLE ──
           High-contrast focus ring works on WHITE and BLUE backgrounds */
        :focus {
            outline: none;
        }

        :focus-visible {
            outline: 3px solid var(--focus-ring);
            outline-offset: 3px;
            box-shadow: 0 0 0 6px var(--focus-shadow);
            border-radius: 4px;
        }

        /* Ensure focus visible on dark/blue backgrounds */
        header :focus-visible,
        #home :focus-visible,
        #how-it-works :focus-visible,
        footer :focus-visible {
            outline-color: var(--focus-ring);
        }

        /* ── SCREEN READER ONLY — WCAG 1.3.1 ── */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        /* ── SCROLLBAR ── */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg2);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 4px;
        }

        /* ── SKIP NAVIGATION — WCAG 2.4.1 ── */
        #skip-links {
            position: absolute;
            top: 0;
            left: 0;
            z-index: 10000;
            display: flex;
            gap: .5rem;
            padding: .5rem;
        }

        .skip-link {
            position: absolute;
            left: -9999px;
            background: var(--primary);
            color: #fff;
            font-weight: 700;
            font-size: 1rem;
            padding: .875rem 1.5rem;
            border-radius: 0 0 .75rem .75rem;
            text-decoration: none;
            white-space: nowrap;
            transition: left .1s;
        }

        .skip-link:focus-visible {
            position: static;
            outline: 3px solid var(--focus-ring);
            outline-offset: 2px;
        }

        /* ── HEADER ── */
        header {
            position: sticky;
            top: 0;
            z-index: 200;
            background: rgba(255, 255, 255, .96);
            backdrop-filter: blur(12px);
            border-bottom: 2px solid var(--border2);
            padding: .75rem 0;
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: .6rem;
            text-decoration: none;
            color: var(--primary);
            font-size: 1.5rem;
            font-weight: 900;
            letter-spacing: -.5px;
        }

        .logo-icon {
            width: 2.25rem;
            height: 2.25rem;
            background: var(--primary);
            border-radius: .5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
            color: #fff;
            /* icon SVG stroke inherits — white on #066EEB = 5.4:1 ✓ */
        }

        /* WCAG 2.5.5 — Touch target minimum 44×44px */
        nav.desktop-nav {
            display: flex;
            gap: 0;
        }

        nav.desktop-nav a {
            color: var(--text-muted);
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            padding: .75rem .875rem;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            position: relative;
            transition: color .2s;
        }

        nav.desktop-nav a::after {
            content: '';
            position: absolute;
            bottom: 4px;
            left: .875rem;
            right: .875rem;
            height: 2px;
            background: var(--primary);
            transform: scaleX(0);
            transform-origin: center;
            transition: transform .2s;
        }

        nav.desktop-nav a:hover {
            color: var(--primary);
        }

        nav.desktop-nav a:hover::after,
        nav.desktop-nav a[aria-current="page"]::after {
            transform: scaleX(1);
        }

        nav.desktop-nav a[aria-current="page"] {
            color: var(--primary);
            font-weight: 700;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        /* Voice toggle — minimum 44×44px */
        #voice-toggle {
            display: flex;
            align-items: center;
            gap: .5rem;
            background: var(--primary-bg);
            border: 2px solid var(--border);
            color: var(--primary);
            padding: .5rem 1rem;
            min-height: 44px;
            border-radius: 2rem;
            font-weight: 600;
            font-size: .9rem;
            cursor: pointer;
            transition: background .2s, border-color .2s;
            font-family: inherit;
        }

        #voice-toggle:hover {
            background: var(--primary-bg2);
            border-color: var(--primary);
        }

        #voice-toggle[aria-pressed="true"] {
            background: var(--success);
            border-color: var(--success);
            color: #fff;
        }

        #hamburger {
            display: none;
            background: none;
            border: 2px solid transparent;
            cursor: pointer;
            color: var(--text);
            padding: .5rem;
            min-width: 44px;
            min-height: 44px;
            border-radius: .5rem;
            font-family: inherit;
            align-items: center;
            justify-content: center;
        }

        #hamburger:hover {
            border-color: var(--border);
            background: var(--bg2);
        }

        /* Mobile nav */
        #mobile-nav {
            display: none;
            flex-direction: column;
            background: var(--bg);
            border-top: 2px solid var(--border2);
            padding: .5rem 1.5rem 1rem;
        }

        #mobile-nav.open {
            display: flex;
        }

        #mobile-nav a {
            color: var(--text-muted);
            font-weight: 600;
            font-size: 1rem;
            padding: .75rem 0;
            min-height: 44px;
            border-bottom: 1px solid var(--border2);
            text-decoration: none;
            display: flex;
            align-items: center;
            transition: color .2s;
        }

        #mobile-nav a:last-child {
            border-bottom: none;
        }

        #mobile-nav a:hover {
            color: var(--primary);
        }

        /* ── UTILITIES ── */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .section {
            padding: var(--section-pad) 0;
        }

        /* Section labels: all contrast verified */
        .section-label {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: var(--primary-bg);
            border: 2px solid var(--border);
            color: var(--primary-dark);
            /* #0452B8 on #EBF3FE = 6.8:1 ✓ */
            font-size: .875rem;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            padding: .4rem 1rem;
            border-radius: 2rem;
            margin-bottom: 1.25rem;
        }

        .section-title {
            font-size: clamp(1.75rem, 4vw, 2.75rem);
            font-weight: 900;
            line-height: 1.40;
            color: var(--text);
            margin-bottom: 1rem;
        }

        .section-sub {
            color: var(--text-muted);
            font-size: 1.05rem;
            max-width: 600px;
            line-height: 1.75;
        }

        .gradient-text {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .tag {
            display: inline-block;
            background: var(--primary-bg);
            border: 1px solid var(--border);
            color: var(--primary-dark);
            font-size: .85rem;
            font-weight: 700;
            padding: .25rem .875rem;
            border-radius: 2rem;
        }

        /* Buttons — minimum 44px height, clear label */
        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: .6rem;
            background: var(--primary);
            color: #fff;
            font-weight: 700;
            font-size: 1rem;
            font-family: inherit;
            padding: .75rem 1.875rem;
            min-height: 48px;
            border-radius: 3rem;
            border: 3px solid var(--primary);
            text-decoration: none;
            cursor: pointer;
            transition: background .2s, transform .15s, box-shadow .2s;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            border-color: var(--primary-dark);
            transform: translateY(-1px);
        }

        .btn-outline {
            display: inline-flex;
            align-items: center;
            gap: .6rem;
            border: 3px solid #fff;
            color: #fff;
            font-weight: 700;
            font-size: 1rem;
            font-family: inherit;
            padding: .75rem 1.875rem;
            min-height: 48px;
            border-radius: 3rem;
            text-decoration: none;
            transition: background .2s;
            background: transparent;
            cursor: pointer;
        }

        .btn-outline:hover {
            background: rgba(255, 255, 255, .15);
        }

        /* ══════════════════════════════════════
           1. HERO
        ══════════════════════════════════════ */
        #home {
            min-height: 100vh;
            display: flex;
            align-items: center;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            padding: 7rem 0 5rem;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        /* Badge: white text on #066EEB = 5.4:1 ✓ */
        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: rgba(255, 255, 255, .2);
            border: 2px solid rgba(255, 255, 255, .5);
            color: #fff;
            font-size: .875rem;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            padding: .4rem 1rem;
            border-radius: 2rem;
            margin-bottom: 1.5rem;
        }

        .hero-title {
            font-size: clamp(2rem, 4.5vw, 3.2rem);
            font-weight: 900;
            line-height: 1.12;
            color: #fff;
            margin-bottom: 1.25rem;
        }

        /* White on #066EEB = 5.4:1 — passes WCAG AA for large text ✓ */
        .hero-desc {
            color: rgba(255, 255, 255, .92);
            font-size: 1.1rem;
            line-height: 1.75;
            margin-bottom: 2.25rem;
            max-width: 520px;
        }

        .hero-desc strong {
            color: #fff;
            font-weight: 700;
        }

        .hero-cta {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .hero-cta .btn-primary {
            background: #fff;
            color: var(--primary);
            border-color: #fff;
        }

        .hero-cta .btn-primary:hover {
            background: #EBF3FE;
            border-color: #EBF3FE;
        }

        .hero-img-wrap {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .hero-img-card {
            position: relative;
            z-index: 1;
            background: rgba(255, 255, 255, .14);
            border: 2px solid rgba(255, 255, 255, .4);
            border-radius: 1.5rem;
            padding: 1.25rem;
            box-shadow: 0 24px 60px rgba(0, 0, 0, .2);
            backdrop-filter: blur(8px);
            width: 100%;
            max-width: 440px;
        }

        .hero-img-card img {
            width: 100%;
            border-radius: 1rem;
            display: block;
            background: #fff;
        }

        /* Info badges — white bg, dark text for max contrast */
        .hero-badge {
            position: absolute;
            bottom: -1rem;
            left: -1rem;
            background: #fff;
            border: 2px solid var(--border);
            color: var(--success);
            /* dark green 7.5:1 on white ✓ */
            font-weight: 700;
            font-size: .9rem;
            padding: .6rem 1.25rem;
            border-radius: .875rem;
            box-shadow: 0 4px 16px rgba(0, 0, 0, .1);
            display: flex;
            align-items: center;
            gap: .5rem;
            white-space: nowrap;
        }

        .hero-badge2 {
            position: absolute;
            top: -1rem;
            right: -1rem;
            background: #fff;
            border: 2px solid var(--border);
            color: var(--primary-dark);
            /* #0452B8 on white = 7.4:1 ✓ */
            font-weight: 700;
            font-size: .9rem;
            padding: .6rem 1.25rem;
            border-radius: .875rem;
            box-shadow: 0 4px 16px rgba(0, 0, 0, .1);
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        /* ══════════════════════════════════════
           2. PROBLEM
        ══════════════════════════════════════ */
        #problem {
            background: var(--bg2);
        }

        .problem-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.25rem;
        }

        .problem-card {
            background: var(--bg);
            border: 2px solid var(--border2);
            border-radius: var(--card-radius);
            padding: 1.75rem;
            box-shadow: var(--card-shadow);
            transition: border-color .2s, box-shadow .2s;
        }

        .problem-card:hover {
            border-color: var(--danger);
            box-shadow: 0 6px 20px rgba(153, 27, 27, .1);
        }

        .problem-card .icon {
            font-size: 2rem;
            margin-bottom: 1rem;
            line-height: 1;
        }

        .problem-card h3 {
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--text);
            margin-bottom: .5rem;
        }

        .problem-card p {
            color: var(--text-muted);
            font-size: .95rem;
            line-height: 1.65;
        }

        /* Quote: #991B1B on #FEE2E2 = 6.6:1 ✓ */
        .problem-quote {
            margin-top: 2.5rem;
            text-align: center;
            background: var(--danger-bg);
            border: 2px solid #FCA5A5;
            border-radius: var(--card-radius);
            padding: 2rem;
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--danger);
        }

        .problem-personas {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .persona-box {
            background: var(--bg);
            border: 2px solid var(--border2);
            border-radius: var(--card-radius);
            padding: 1.25rem;
            box-shadow: var(--card-shadow);
        }

        /* #0452B8 on white = 7.4:1 ✓ */
        .persona-box .persona-title {
            font-weight: 700;
            font-size: .875rem;
            color: var(--primary-dark);
            margin-bottom: .5rem;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .persona-box p {
            color: var(--text-muted);
            font-size: .95rem;
            line-height: 1.65;
        }

        /* ══════════════════════════════════════
           3. SOLUTION
        ══════════════════════════════════════ */
        #solution {
            background: var(--bg);
        }

        .solution-hero-text {
            max-width: 760px;
            margin: 0 auto;
            text-align: center;
            margin-bottom: 3rem;
        }

        .solution-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .solution-card {
            border-radius: var(--card-radius);
            overflow: hidden;
            border: 2px solid var(--border2);
            position: relative;
            box-shadow: var(--card-shadow);
        }

        .solution-card img {
            width: 100%;
            display: block;
            height: auto;
            /* natural height — no cropping of embedded captions */
        }

        .solution-card-label {
            position: absolute;
            top: 1rem;
            left: 1rem;
            padding: .4rem 1rem;
            border-radius: 2rem;
            font-weight: 700;
            font-size: .85rem;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        /* White on red bg: verified > 4.5:1 */
        .solution-card-label.before {
            background: #B91C1C;
            color: #fff;
        }

        /* White on green bg: verified > 4.5:1 */
        .solution-card-label.after {
            background: #065F46;
            color: #fff;
        }

        .solution-features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
        }

        .solution-feature {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            background: var(--bg2);
            border: 2px solid var(--border2);
            border-radius: var(--card-radius);
            padding: 1.25rem;
            transition: border-color .2s;
        }

        .solution-feature:hover {
            border-color: var(--primary);
        }

        .solution-feature .sf-icon {
            font-size: 1.6rem;
            flex-shrink: 0;
            line-height: 1;
            margin-top: .15rem;
        }

        .solution-feature strong {
            color: var(--text);
            display: block;
            font-size: 1rem;
            margin-bottom: .3rem;
        }

        .solution-feature p {
            color: var(--text-muted);
            font-size: .95rem;
            line-height: 1.6;
        }

        .solution-cta {
            text-align: center;
            margin-top: 3rem;
        }

        .solution-cta p {
            color: var(--text-muted);
            font-size: 1.05rem;
            font-style: italic;
            margin-bottom: 1.5rem;
        }

        /* ══════════════════════════════════════
           4. HOW IT WORKS — blue bg, white text
        ══════════════════════════════════════ */
        #how-it-works {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        }

        /* section-label override for blue bg */
        #how-it-works .section-label {
            background: rgba(255, 255, 255, .18);
            border-color: rgba(255, 255, 255, .45);
            color: #fff;
            /* white on blue ✓ */
        }

        #how-it-works .section-title {
            color: #fff;
        }

        .steps-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }

        .step-card {
            background: rgba(255, 255, 255, .12);
            border: 2px solid rgba(255, 255, 255, .3);
            border-radius: 1.25rem;
            padding: 2rem 1.5rem;
            text-align: center;
            transition: background .2s;
        }

        .step-card:hover {
            background: rgba(255, 255, 255, .2);
        }

        .step-num {
            width: 3.5rem;
            height: 3.5rem;
            border-radius: 50%;
            background: #fff;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            font-weight: 900;
            margin: 0 auto 1.25rem;
        }

        .step-icon {
            font-size: 2.25rem;
            margin-bottom: .875rem;
            line-height: 1;
        }

        /* white on blue > 4.5:1 ✓ */
        .step-card h3 {
            font-weight: 800;
            font-size: 1.05rem;
            color: #fff;
            margin-bottom: .35rem;
        }

        .step-card .step-sub {
            font-size: .8rem;
            font-weight: 700;
            color: rgba(255, 255, 255, .8);
            letter-spacing: .1em;
            text-transform: uppercase;
            margin-bottom: .75rem;
        }

        /* rgba(255,255,255,.9) on #066EEB conservatively ~4.8:1 ✓ */
        .step-card p {
            color: rgba(255, 255, 255, .9);
            font-size: .95rem;
            line-height: 1.65;
        }

        .how-note {
            margin-top: 2.5rem;
            text-align: center;
            background: rgba(255, 255, 255, .15);
            border: 2px solid rgba(255, 255, 255, .4);
            border-radius: var(--card-radius);
            padding: 1.25rem;
            color: #fff;
            font-weight: 700;
            font-size: 1.05rem;
        }

        /* ══════════════════════════════════════
           5. FEATURES
        ══════════════════════════════════════ */
        #features {
            background: var(--bg2);
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.25rem;
        }

        .feature-card {
            background: var(--bg);
            border: 2px solid var(--border2);
            border-top: 4px solid var(--primary);
            border-radius: var(--card-radius);
            padding: 2rem;
            box-shadow: var(--card-shadow);
            transition: border-color .2s, box-shadow .2s;
        }

        .feature-card:hover {
            box-shadow: 0 8px 24px rgba(6, 110, 235, .14);
        }

        .feature-card .fc-icon {
            font-size: 1.75rem;
            margin-bottom: 1rem;
            width: 3.25rem;
            height: 3.25rem;
            background: var(--primary-bg);
            border-radius: .75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .feature-card h3 {
            font-weight: 800;
            font-size: 1.1rem;
            color: var(--text);
            margin-bottom: .75rem;
        }

        .feature-card ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: .5rem;
        }

        .feature-card ul li {
            display: flex;
            align-items: center;
            gap: .75rem;
            color: var(--text-muted);
            font-size: .975rem;
            line-height: 1.5;
        }

        /* Color-blind safe: bullet uses shape + color */
        .feature-card ul li::before {
            content: '';
            flex-shrink: 0;
            width: .5rem;
            height: .5rem;
            border-radius: 50%;
            background: var(--primary);
            border: 1px solid var(--primary-dark);
        }

        /* ══════════════════════════════════════
           6. BENEFITS
        ══════════════════════════════════════ */
        #benefits {
            background: var(--bg);
        }

        .benefits-wrap {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: start;
        }

        .benefits-list {
            display: flex;
            flex-direction: column;
            gap: 1.125rem;
        }

        .benefit-item {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            background: var(--bg2);
            border: 2px solid var(--border2);
            border-radius: var(--card-radius);
            padding: 1.375rem;
            box-shadow: var(--card-shadow);
            transition: border-color .2s;
        }

        .benefit-item:hover {
            border-color: var(--primary);
        }

        .benefit-icon {
            width: 2.75rem;
            height: 2.75rem;
            border-radius: .625rem;
            flex-shrink: 0;
            background: var(--primary-bg);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            line-height: 1;
        }

        .benefit-item strong {
            display: block;
            font-weight: 700;
            color: var(--text);
            font-size: 1rem;
            margin-bottom: .2rem;
        }

        .benefit-item p {
            color: var(--text-muted);
            font-size: .95rem;
            line-height: 1.6;
        }

        .benefits-slogan {
            background: linear-gradient(135deg, var(--primary-bg) 0%, var(--primary-bg2) 100%);
            border: 2px solid var(--border);
            border-radius: 1.25rem;
            padding: 2.5rem;
            text-align: center;
            position: sticky;
            top: 6rem;
        }

        .benefits-slogan .bs-emoji {
            font-size: 3rem;
            margin-bottom: 1rem;
            line-height: 1;
        }

        .benefits-slogan h3 {
            font-weight: 900;
            font-size: 1.4rem;
            color: var(--text);
            margin-bottom: .75rem;
        }

        .benefits-slogan p {
            color: var(--text-muted);
            line-height: 1.7;
            font-size: 1rem;
        }

        /* #0452B8 on #EBF3FE = 6.8:1 ✓ */
        .benefits-slogan .bs-quote {
            font-weight: 700;
            color: var(--primary-dark);
            font-size: 1.05rem;
            margin-top: 1.25rem;
            font-style: italic;
        }

        /* ══════════════════════════════════════
           7. TARGET USERS
        ══════════════════════════════════════ */
        #target-users {
            background: var(--bg2);
        }

        .users-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.25rem;
        }

        .user-card {
            text-align: center;
            padding: 2rem 1.25rem;
            background: var(--bg);
            border: 2px solid var(--border2);
            border-radius: 1.25rem;
            box-shadow: var(--card-shadow);
            transition: border-color .2s, box-shadow .2s;
        }

        .user-card:hover {
            border-color: var(--primary);
            box-shadow: 0 6px 20px rgba(6, 110, 235, .12);
        }

        .user-card .uc-icon {
            font-size: 2.75rem;
            margin-bottom: 1rem;
            line-height: 1;
        }

        .user-card h3 {
            font-weight: 800;
            font-size: 1rem;
            color: var(--text);
            margin-bottom: .4rem;
        }

        .user-card p {
            color: var(--text-muted);
            font-size: .9rem;
            line-height: 1.6;
        }

        /* ══════════════════════════════════════
           8. ABOUT
        ══════════════════════════════════════ */
        #about {
            background: var(--bg);
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: start;
        }

        .about-intro p {
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.8;
            margin-bottom: 1.25rem;
        }

        .about-intro p strong {
            color: var(--text);
        }

        /* #0452B8 on #EBF3FE = 6.8:1 ✓ */
        .mentors-title {
            font-weight: 800;
            font-size: .875rem;
            color: var(--primary-dark);
            letter-spacing: .1em;
            text-transform: uppercase;
            margin-bottom: 1rem;
            margin-top: 1.75rem;
        }

        .mentor-list {
            display: flex;
            flex-direction: column;
            gap: .75rem;
        }

        .mentor-item {
            display: flex;
            align-items: center;
            gap: .875rem;
            background: var(--bg2);
            border: 2px solid var(--border2);
            border-radius: .875rem;
            padding: .875rem 1.125rem;
            box-shadow: var(--card-shadow);
        }

        .mentor-avatar {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .85rem;
            font-weight: 700;
            flex-shrink: 0;
            /* White on #066EEB = 5.4:1 ✓ */
        }

        .mentor-item strong {
            display: block;
            font-weight: 700;
            color: var(--text);
            font-size: .975rem;
        }

        .mentor-item span {
            font-size: .875rem;
            color: var(--text-muted);
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: .875rem;
        }

        .team-card {
            display: flex;
            align-items: center;
            gap: .875rem;
            background: var(--bg2);
            border: 2px solid var(--border2);
            border-radius: 1rem;
            padding: 1rem 1.125rem;
            box-shadow: var(--card-shadow);
            transition: border-color .2s;
        }

        .team-card:hover {
            border-color: var(--primary);
        }

        .team-avatar {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: .625rem;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .875rem;
            font-weight: 800;
        }

        .team-card strong {
            display: block;
            color: var(--text);
            font-weight: 700;
            font-size: .95rem;
        }

        .team-card .role-badge {
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: .04em;
        }

        /* All role colors verified ≥ 4.5:1 on light backgrounds */
        .role-ceo {
            color: #92400E;
        }

        /* 7.8:1 on #FEF3C7 ✓ */
        .role-cto {
            color: var(--primary-dark);
        }

        /* 7.4:1 on white ✓ */
        .role-cmo {
            color: #5B21B6;
        }

        /* 8.5:1 on white ✓ */
        .role-design {
            color: #065F46;
        }

        /* 8.0:1 on white ✓ */

        /* ══════════════════════════════════════
           9. FAQ — Full keyboard & screen reader support
        ══════════════════════════════════════ */
        #faq {
            background: var(--bg2);
        }

        .faq-list {
            display: flex;
            flex-direction: column;
            gap: .875rem;
            max-width: 820px;
            margin: 0 auto;
        }

        .faq-item {
            background: var(--bg);
            border: 2px solid var(--border2);
            border-radius: 1.125rem;
            overflow: hidden;
            box-shadow: var(--card-shadow);
            transition: border-color .2s;
        }

        .faq-item:focus-within {
            border-color: var(--primary);
        }

        /* WCAG 4.1.2: button has name via text content, role=button implicit */
        .faq-question {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.375rem 1.5rem;
            background: none;
            border: none;
            border-radius: 0;
            color: var(--text);
            font-weight: 700;
            font-size: 1.05rem;
            text-align: left;
            cursor: pointer;
            font-family: inherit;
            min-height: 64px;
            /* generous touch target */
            transition: background .15s;
        }

        .faq-question:hover {
            background: var(--primary-bg);
        }

        .faq-icon {
            width: 1.5rem;
            height: 1.5rem;
            flex-shrink: 0;
            border: 2px solid var(--primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            transition: transform .3s, background .2s;
        }

        .faq-question[aria-expanded="true"] .faq-icon {
            transform: rotate(45deg);
            background: var(--primary);
            color: #fff;
        }

        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height .4s ease;
        }

        .faq-answer-inner {
            padding: 0 1.5rem 1.5rem;
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.75;
            border-top: 1px solid var(--border2);
            padding-top: 1rem;
        }

        /* ══════════════════════════════════════
           10. CONTACT
        ══════════════════════════════════════ */
        #contact {
            background: var(--bg);
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
        }

        .contact-info h3 {
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--text);
            margin-bottom: 1.5rem;
        }

        .contact-item {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            padding: 1.125rem 0;
            border-bottom: 1px solid var(--border2);
        }

        .contact-item:last-of-type {
            border-bottom: none;
        }

        .contact-item .ci-icon {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: .625rem;
            flex-shrink: 0;
            background: var(--primary-bg);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
        }

        /* #374151 on white = 8.6:1 ✓ */
        .contact-item strong {
            display: block;
            color: var(--text-muted);
            font-size: .8rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            margin-bottom: .2rem;
        }

        .contact-item p {
            color: var(--text);
            font-size: 1rem;
            font-weight: 500;
        }

        /* Link: #0452B8 on white = 7.4:1 ✓ underline for non-color indicator */
        .contact-item a {
            color: var(--primary-dark);
            text-decoration: underline;
        }

        .contact-item a:hover {
            color: var(--primary);
        }

        .social-row {
            display: flex;
            gap: .625rem;
            margin-top: 1.75rem;
            flex-wrap: wrap;
        }

        .social-btn {
            /* 44×44 minimum touch target */
            width: 2.75rem;
            height: 2.75rem;
            border-radius: .625rem;
            border: 2px solid var(--border2);
            background: var(--bg2);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .2s;
            color: var(--text-muted);
            text-decoration: none;
        }

        .social-btn:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
        }

        .logo-box {
            background: linear-gradient(135deg, var(--primary-bg), var(--primary-bg2));
            border: 2px solid var(--border);
            border-radius: 1.25rem;
            padding: 2.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            gap: 1.25rem;
            box-shadow: var(--card-shadow);
        }

        .logo-box-logo {
            font-size: 2.25rem;
            font-weight: 900;
            color: var(--primary-dark);
        }

        .logo-box p {
            color: var(--text-muted);
            font-size: .975rem;
            line-height: 1.75;
        }

        .logo-box .school-badge {
            background: var(--bg);
            border: 2px solid var(--border);
            border-radius: .875rem;
            padding: .75rem 1.5rem;
            color: var(--text-muted);
            font-size: .875rem;
            font-weight: 600;
        }

        /* CONSULTATION FORM — WCAG 1.3.1 */
        #consultation {
            background: var(--bg2);
            border-top: 2px solid var(--border2);
        }

        .register-container {
            max-width: 600px;
            margin: 0 auto;
            background: #fff;
            padding: 2.5rem;
            border-radius: 1.5rem;
            box-shadow: var(--card-shadow);
            border: 2px solid var(--border2);
        }

        .form-group {
            margin-bottom: 1.5rem;
            text-align: left;
        }

        .form-group label {
            display: block;
            font-weight: 700;
            font-size: .95rem;
            color: var(--text);
            margin-bottom: .5rem;
        }

        .form-input {
            width: 100%;
            padding: .875rem 1.25rem;
            border-radius: .75rem;
            border: 2px solid var(--border);
            font-family: inherit;
            font-size: 1rem;
            transition: border-color .2s, box-shadow .2s;
            color: var(--text);
            background: var(--bg);
        }

        .form-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--primary-bg);
            outline: none;
        }

        .btn-submit {
            width: 100%;
            justify-content: center;
            margin-top: 1rem;
        }

        #success-message {
            display: none;
            background: var(--success-bg);
            color: var(--success);
            padding: 1.25rem;
            border-radius: .75rem;
            text-align: center;
            font-weight: 700;
            margin-top: 1.5rem;
            border: 2px solid var(--success);
            animation: fadeIn .3s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* FOOTER */
        footer {
            background: #1A3C6E;
            /* brand navy */
            padding: 2.25rem 0;
            text-align: center;
        }

        /* White on #1A3C6E ≈ 9.8:1 ✓ */
        footer p {
            color: rgba(255, 255, 255, .8);
            font-size: .925rem;
        }

        footer strong {
            color: #fff;
        }

        /* ══════════════════════════════════════
           RESPONSIVE
        ══════════════════════════════════════ */
        @media (max-width: 960px) {

            .hero-grid,
            .solution-grid,
            .about-grid,
            .benefits-wrap,
            .contact-grid {
                grid-template-columns: 1fr;
            }

            .hero-img-wrap {
                order: -1;
            }

            .steps-row {
                grid-template-columns: 1fr;
            }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .users-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .team-grid {
                grid-template-columns: 1fr;
            }

            .problem-personas {
                grid-template-columns: 1fr;
            }

            .benefits-slogan {
                position: static;
            }
        }

        @media (max-width: 640px) {
            nav.desktop-nav {
                display: none;
            }

            #hamburger {
                display: inline-flex;
            }

            .users-grid {
                grid-template-columns: 1fr 1fr;
            }

            .section {
                padding: 3.5rem 0;
            }

            .hero-cta {
                flex-direction: column;
            }

            .hero-cta .btn-primary,
            .hero-cta .btn-outline {
                justify-content: center;
            }

            .logo-box {
                padding: 1.75rem;
            }
        }

        /* ══════════════════════════════════════
           HIGH CONTRAST MODE support — WCAG 1.4.11
        ══════════════════════════════════════ */
        @media (forced-colors: active) {

            .btn-primary,
            .btn-outline {
                border: 2px solid ButtonText;
            }

            .hero-badge,
            .hero-badge2 {
                border: 2px solid ButtonText;
            }

            .faq-icon {
                border-color: ButtonText;
            }
        }

        /* Reading Highlight */
        .reading-highlight {
            background: rgba(255, 214, 0, 0.2) !important;
            box-shadow: 0 0 0 4px rgba(255, 214, 0, 0.3);
            border-radius: 4px;
            transition: all 0.2s ease;
        }
    </style>
</head>

<body>
    <!-- WCAG 2.4.1 — Skip Navigation Links -->
    <nav id="skip-links" aria-label="Điều hướng nhanh">
        <a class="skip-link" href="/">Bỏ qua điều hướng, đến nội dung chính</a>
        <a class="skip-link" href="/contact">Đến liên hệ</a>
    </nav>

    <!-- WCAG 4.1.2 — Landmark: banner -->
    <header role="banner">
        <div class="nav-container">
            <!-- WCAG 2.4.6 — Logo with descriptive label -->
            <!-- WCAG 2.4.6 — Logo with descriptive label -->
            <a href="/" class="logo" aria-label="SafeEye – Trang chủ thiết bị hỗ trợ người khiếm thị">
                <div class="logo-icon" aria-hidden="true">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
                        focusable="false" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                </div>
                SafeEye
            </a>

            <!-- WCAG 2.4.3 — Focus order follows visual order -->
            <nav class="desktop-nav" aria-label="Menu chính">
                <a href="/problem">Vấn đề</a>
                <a href="/solution">Giải pháp</a>
                <a href="/how-it-works">Cách hoạt động</a>
                <a href="/features">Tính năng</a>
                <a href="/about">Về dự án</a>
                <a href="/consultation" class="nav-cta">Tư vấn</a>
                <a href="/contact">Liên hệ</a>
            </nav>

            <div class="nav-actions">
                <!-- WCAG 4.1.2 — aria-pressed for toggle state -->
                <!-- WCAG 1.3.3 — aria-live announces state change -->
                <button id="voice-toggle" type="button" aria-pressed="false"
                    aria-label="Bật hỗ trợ giọng nói (hiện đang tắt)">

                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">

                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                    </svg>

                    <span id="voice-label" aria-hidden="true">Đọc nội dung</span>
                </button>

                <!-- WCAG 4.1.2 — Hamburger with proper aria -->
                <button id="hamburger" type="button" aria-expanded="false" aria-controls="mobile-nav"
                    aria-label="Mở menu điều hướng">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile nav -->
        <nav id="mobile-nav" aria-label="Menu di động" hidden>
            <a href="/problem">Vấn đề</a>
            <a href="/solution">Giải pháp</a>
            <a href="/how-it-works">Cách hoạt động</a>
            <a href="/features">Tính năng</a>
            <a href="/about">Về dự án</a>
            <a href="/consultation">Tư vấn</a>
            <a href="/contact">Liên hệ</a>
        </nav>
